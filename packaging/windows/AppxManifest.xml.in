<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft Store 提出用の MSIX マニフェストのテンプレート。
  `packaging/windows/make-msix.ps1` が @VERSION@ / @PUBLISHER@ を置き換える。

  Publisher は Partner Center の「パッケージ ID の Publisher」と完全一致させること。
  Store が再署名するため、こちらで証明書を用意する必要はない。
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">
  <Identity Name="@IDENTITY_NAME@"
            Publisher="@PUBLISHER@"
            Version="@VERSION@"
            ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Ligrol</DisplayName>
    <PublisherDisplayName>MegaBlackLabel</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="ja-jp" />
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="ligrol.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Ligrol"
        Description="購入した本をローカルで読むビューアー"
        BackgroundColor="#0F172A"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>
      <!--
        MCP サーバーを外部クライアント（Claude Desktop / Cursor など）から起動できるようにする。
        `WindowsApps` 直下の exe は外部プロセスから起動できず EPERM になるため、
        App Execution Alias を宣言する。実体ではなく 0 バイトの再解析ポイントで、
        署名・パッケージ整合性の検証は維持される。

        登録時に次の 2 か所へ作られる:
        - `%LOCALAPPDATA%\Microsoft\WindowsApps\ligrol-mcp.exe`（PATH 版。Settings で無効化可）
        - `%LOCALAPPDATA%\Microsoft\WindowsApps\<PFN>\ligrol-mcp.exe`（固定版。設定の影響を受けない）

        アプリ内の「AI / MCP」設定コピーは後者を案内する（crates/app/src/mcp_config.rs）。
      -->
      <Extensions>
        <uap3:Extension
          Category="windows.appExecutionAlias"
          Executable="ligrol-mcp.exe"
          EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="ligrol-mcp.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <!-- WebView2（ログイン）と通常の Win32 動作に必要 -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
